# Required environment variables for Outrospect backend

# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/outrospect
DATABASE_URL=

# Telegram MTProto credentials (personal account — not a bot)
# Get api_id and api_hash from https://my.telegram.org/auth → API development tools.
# Generate TELEGRAM_SESSION_STRING once by running: python scripts/telegram_login.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# LLM provider API key (OpenAI, Anthropic, etc.)
LLM_API_KEY=

# LLM model identifier used for classification
# Example: gpt-4o-mini  or  claude-3-haiku-20240307
LLM_MODEL=gpt-4o-mini

# Origin of the Next.js frontend for CORS (no trailing slash)
# Dev default: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
